    let currentTab = 'characters';
    let currentSubFilter = 'all';
    let searchQuery = '';

    const subFilterConfig = {
        characters: [
            { id: 'all', label: 'Alla' },
            { id: 'lapd', label: 'LAPD' },
            { id: 'tyrell', label: 'Tyrell Corporation' },
            { id: 'civilians', label: 'Civila & Övriga' }
        ],
        locations: [
            { id: 'all', label: 'Alla' },
            { id: 'corporate', label: 'Företag & Labb' },
            { id: 'city', label: 'Myndigheter & Stadsmiljö' }
        ],
        lore: [],
        timeline: []
    };

    function getSavedImage(charId, defaultImg, fallbackImg) {
        const stored = localStorage.getItem('br_wiki_img_' + charId);
        if (stored) return stored;
        return defaultImg || fallbackImg;
    }

    function renderSubTabs() {
        const subTabsEl = document.getElementById('subTabs');
        const filters = subFilterConfig[currentTab] || [];

        if (filters.length === 0) {
            subTabsEl.style.display = 'none';
            return;
        }

        subTabsEl.style.display = 'flex';
        const items = wikiData[currentTab] || [];

        subTabsEl.innerHTML = filters.map(f => {
            const count = f.id === 'all'
                ? items.length
                : items.filter(i => i.faction === f.id).length;
            return `<button class="sub-tab-btn ${currentSubFilter === f.id ? 'active' : ''}" data-filter="${f.id}">
                ${f.label} (${count})
            </button>`;
        }).join('');

        subTabsEl.querySelectorAll('.sub-tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                currentSubFilter = btn.dataset.filter;
                renderSubTabs();
                renderContent();
            });
        });
    }

    function renderContent() {
        const contentArea = document.getElementById('contentArea');
        const query = searchQuery.toLowerCase().trim();

        if (currentTab === 'timeline') {
            const filtered = wikiData.timeline.filter(item =>
                item.title.toLowerCase().includes(query) ||
                item.year.toLowerCase().includes(query) ||
                item.format.toLowerCase().includes(query)
            );

            contentArea.innerHTML = `<div class="timeline-list">
                ${filtered.map(item => `
                    <div class="timeline-item ${item.active ? 'active-item' : 'locked-item'}">
                        <div class="timeline-year">${item.year}</div>
                        <div class="timeline-info">
                            <div class="timeline-title">${item.title}</div>
                            <div class="timeline-meta">${item.format} &bull; ${item.desc}</div>
                        </div>
                        <span class="badge ${item.active ? 'badge-unknown' : 'badge-faction'}">${item.status}</span>
                    </div>
                `).join('')}
            </div>`;
            return;
        }

        let items = wikiData[currentTab] || [];

        if (currentSubFilter !== 'all') {
            items = items.filter(item => item.faction === currentSubFilter);
        }

        if (query) {
            items = items.filter(item =>
                item.name.toLowerCase().includes(query) ||
                item.role.toLowerCase().includes(query) ||
                item.summary.toLowerCase().includes(query)
            );
        }

        if (items.length === 0) {
            contentArea.innerHTML = `<div class="empty-state">Inga arkivposter matchade din sökning eller filtrering.</div>`;
            return;
        }

        contentArea.innerHTML = `<div class="grid">
            ${items.map(item => {
                const badgeClass = item.statusType === 'alive' ? 'badge-alive' :
                                   item.statusType === 'dead' ? 'badge-dead' : 'badge-unknown';
                return `
                    <div class="card" onclick="openDetail('${currentTab}', '${item.id}')">
                        <div>
                            <div class="card-header">
                                <div class="card-title">${item.name}</div>
                                <span class="badge ${badgeClass}">${item.status}</span>
                            </div>
                            <div class="card-role">${item.role}</div>
                            <div class="card-desc">${item.summary}</div>
                        </div>
                        <div class="card-footer">
                            <span>${item.factionLabel || 'ARKIVPOST'}</span>
                            <span>ÖPPNA FIL &rarr;</span>
                        </div>
                    </div>
                `;
            }).join('')}
        </div>`;
    }

    function openDetail(category, id) {
        const item = (wikiData[category] || []).find(i => i.id === id);
        if (!item) return;

        const modalOverlay = document.getElementById('modalOverlay');
        const modalBody = document.getElementById('modalBody');

        if (category === 'characters') {
            const imgSrc = getSavedImage(item.id, item.defaultImage, item.fallbackImage);
            modalBody.innerHTML = `
                <div class="wiki-layout">
                    <div class="wiki-main">
                        <h2>${item.name}</h2>
                        <div class="wiki-subtitle">${item.role} &bull; ${item.factionLabel}</div>

                        <div class="wiki-section">
                            <h3>Biografi & Bakgrund</h3>
                            <p>${item.bio}</p>
                        </div>

                        <div class="wiki-section">
                            <h3>Händelser (t.o.m. Origins #3)</h3>
                            <p>${item.events}</p>
                        </div>
                    </div>

                    <aside class="wiki-infobox">
                        <div class="infobox-header">${item.name}</div>
                        <div class="infobox-image-wrap">
                            <img id="charPortraitImg" src="${imgSrc}" alt="${item.name}" onerror="this.onerror=null; this.src='${item.fallbackImage}';">
                        </div>
                        <div class="upload-overlay">
                            <label class="upload-btn" for="portraitUploadInput">Ladda upp / Byt bild</label>
                            <input type="file" id="portraitUploadInput" accept="image/*" style="display:none;" onchange="handleImageUpload(event, '${item.id}')">
                        </div>
                        <table class="infobox-table">
                            <tr><th>Status</th><td>${item.status}</td></tr>
                            <tr><th>Född</th><td>${item.born}</td></tr>
                            <tr><th>Död</th><td>${item.died}</td></tr>
                            <tr><th>Familj</th><td>${item.family}</td></tr>
                            <tr><th>Yrke</th><td>${item.occupation}</td></tr>
                            <tr><th>Tillhörighet</th><td>${item.affiliation}</td></tr>
                            <tr><th>Först sedd</th><td>${item.firstAppearance}</td></tr>
                        </table>
                    </aside>
                </div>
            `;
        } else {
            modalBody.innerHTML = `
                <div class="wiki-main">
                    <h2>${item.name}</h2>
                    <div class="wiki-subtitle">${item.role} &bull; Status: ${item.status}</div>
                    <div class="wiki-section">
                        <h3>Översikt</h3>
                        <p>${item.summary}</p>
                    </div>
                    <div class="wiki-section">
                        <h3>Arkivdata (t.o.m. Origins #3)</h3>
                        <p>${item.details}</p>
                    </div>
                </div>
            `;
        }

        modalOverlay.classList.add('open');
    }

    function handleImageUpload(event, charId) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const dataUrl = e.target.result;
            try {
                localStorage.setItem('br_wiki_img_' + charId, dataUrl);
                const imgEl = document.getElementById('charPortraitImg');
                if (imgEl) imgEl.src = dataUrl;
            } catch (err) {
                alert('Bilden är för stor för webbläsarens lokala minne. Prova en mindre bildfil.');
            }
        };
        reader.readAsDataURL(file);
    }

    document.getElementById('mainTabs').addEventListener('click', (e) => {
        if (!e.target.classList.contains('tab-btn')) return;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        currentTab = e.target.dataset.tab;
        currentSubFilter = 'all';
        renderSubTabs();
        renderContent();
    });

    document.getElementById('searchInput').addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderContent();
    });

    document.getElementById('closeModal').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('open');
    });

    document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target.id === 'modalOverlay') {
            document.getElementById('modalOverlay').classList.remove('open');
        }
    });

    renderSubTabs();
    renderContent();
</script>

