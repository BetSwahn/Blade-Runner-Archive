<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blade Runner // Archive</title>
    <style>
        :root {
            --bg-primary: #090b0e;
            --bg-secondary: #11151c;
            --bg-card: #161b24;
            --bg-card-hover: #1c2330;
            --accent-amber: #ff9e00;
            --accent-amber-glow: rgba(255, 158, 0, 0.25);
            --accent-teal: #00f0ff;
            --accent-teal-glow: rgba(0, 240, 255, 0.2);
            --accent-red: #ff3355;
            --accent-green: #00e676;
            --text-main: #e2e8f0;
            --text-muted: #8b9bb4;
            --border-color: #263042;
            --font-sans: 'Josefin Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
            --font-mono: 'Courier New', Courier, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            font-family: var(--font-sans);
            line-height: 1.6;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
                        linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
            z-index: 9999;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 24px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .brand h1 {
            font-size: 1.85rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #fff;
            text-shadow: 0 0 12px var(--accent-amber-glow);
        }

        .brand h1 span {
            color: var(--accent-amber);
        }

        .brand p {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--accent-teal);
            margin-top: 4px;
        }

        .spoiler-shield {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid var(--accent-teal);
            padding: 8px 14px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--accent-teal);
            box-shadow: 0 0 12px var(--accent-teal-glow);
        }

        .controls {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tab-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 10px 18px;
            border-radius: 4px;
            cursor: pointer;
            font-family: var(--font-sans);
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
        }

        .tab-btn:hover {
            border-color: var(--accent-amber);
            color: #fff;
        }

        .tab-btn.active {
            background: rgba(255, 158, 0, 0.15);
            border-color: var(--accent-amber);
            color: var(--accent-amber);
            box-shadow: 0 0 12px var(--accent-amber-glow);
        }

        .sub-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 22px;
            padding-bottom: 12px;
            border-bottom: 1px dashed var(--border-color);
        }

        .sub-tab-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            transition: all 0.2s ease;
        }

        .sub-tab-btn:hover {
            border-color: var(--accent-teal);
            color: #fff;
        }

        .sub-tab-btn.active {
            background: rgba(0, 240, 255, 0.15);
            border-color: var(--accent-teal);
            color: var(--accent-teal);
        }

        .search-box {
            position: relative;
            flex: 1;
            min-width: 240px;
            max-width: 340px;
        }

        .search-box input {
            width: 100%;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            color: #fff;
            padding: 10px 14px;
            border-radius: 4px;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            outline: none;
        }

        .search-box input:focus {
            border-color: var(--accent-teal);
            box-shadow: 0 0 10px var(--accent-teal-glow);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 3px; height: 100%;
            background: var(--accent-amber);
            opacity: 0.6;
            transition: opacity 0.2s;
        }

        .card:hover {
            background: var(--bg-card-hover);
            border-color: var(--accent-amber);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
        }

        .card:hover::before {
            opacity: 1;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
        }

        .badge {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 3px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .badge-alive { background: rgba(0, 230, 118, 0.12); color: var(--accent-green); border: 1px solid rgba(0, 230, 118, 0.4); }
        .badge-dead { background: rgba(255, 51, 85, 0.12); color: var(--accent-red); border: 1px solid rgba(255, 51, 85, 0.4); }
        .badge-unknown { background: rgba(255, 158, 0, 0.12); color: var(--accent-amber); border: 1px solid rgba(255, 158, 0, 0.4); }
        .badge-faction { background: rgba(0, 240, 255, 0.1); color: var(--accent-teal); border: 1px solid rgba(0, 240, 255, 0.3); }

        .card-role {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--accent-amber);
            margin-bottom: 10px;
        }

        .card-desc {
            font-size: 0.92rem;
            color: var(--text-muted);
            margin-bottom: 14px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .card-footer {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 10px;
            display: flex;
            justify-content: space-between;
        }

        .timeline-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .timeline-item {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px 20px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .timeline-item.active-item {
            border-color: var(--accent-amber);
            background: linear-gradient(90deg, rgba(255, 158, 0, 0.08), var(--bg-card));
        }

        .timeline-item.locked-item {
            opacity: 0.55;
        }

        .timeline-year {
            font-family: var(--font-mono);
            font-size: 0.95rem;
            color: var(--accent-teal);
            min-width: 95px;
        }

        .timeline-info {
            flex: 1;
            min-width: 240px;
        }

        .timeline-title {
            font-weight: 700;
            font-size: 1.05rem;
            color: #fff;
        }

        .timeline-meta {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 7, 10, 0.88);
            backdrop-filter: blur(4px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal {
            background: var(--bg-secondary);
            border: 1px solid var(--accent-amber);
            border-radius: 8px;
            max-width: 880px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 28px;
            position: relative;
            box-shadow: 0 0 35px rgba(0, 0, 0, 0.8);
        }

        .close-btn {
            position: absolute;
            top: 18px;
            right: 20px;
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 1.2rem;
            width: 34px;
            height: 34px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .close-btn:hover {
            border-color: var(--accent-red);
            color: var(--accent-red);
        }

        .wiki-layout {
            display: grid;
            grid-template-columns: 1fr 290px;
            gap: 28px;
            margin-top: 10px;
        }

        @media (max-width: 768px) {
            .wiki-layout {
                grid-template-columns: 1fr;
            }
            .wiki-infobox {
                order: -1;
            }
        }

        .wiki-main h2 {
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 4px;
        }

        .wiki-subtitle {
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--accent-amber);
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
        }

        .wiki-section {
            margin-bottom: 20px;
        }

        .wiki-section h3 {
            font-size: 1.05rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-teal);
            margin-bottom: 8px;
        }

        .wiki-section p {
            color: var(--text-main);
            font-size: 0.96rem;
            margin-bottom: 10px;
        }

        .wiki-infobox {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
        }

        .infobox-header {
            background: rgba(255, 158, 0, 0.15);
            color: var(--accent-amber);
            text-align: center;
            font-weight: 700;
            padding: 10px;
            font-size: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .infobox-image-wrap {
            width: 100%;
            aspect-ratio: 3 / 4;
            background: #0c0f14;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-bottom: 1px solid var(--border-color);
        }

        .infobox-image-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .upload-overlay {
            padding: 10px;
            text-align: center;
            background: rgba(0, 0, 0, 0.4);
            border-bottom: 1px solid var(--border-color);
        }

        .upload-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--accent-teal);
            color: var(--accent-teal);
            padding: 6px 12px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-block;
        }

        .upload-btn:hover {
            background: rgba(0, 240, 255, 0.15);
        }

        .infobox-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .infobox-table tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .infobox-table th {
            text-align: left;
            padding: 8px 12px;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            width: 38%;
            vertical-align: top;
        }

        .infobox-table td {
            padding: 8px 12px;
            color: #fff;
            vertical-align: top;
        }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-family: var(--font-mono);
            border: 1px dashed var(--border-color);
            border-radius: 6px;
        }
    </style>
</head>
